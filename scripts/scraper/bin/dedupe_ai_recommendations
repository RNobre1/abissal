#!/usr/bin/env ruby
# frozen_string_literal: true

# dedupe_ai_recommendations — limpa recos duplicadas em ai_recommendations.
#
# Contexto (Bug 1 — 2026-06-09):
#   Fixtures com KO na janela 24-48h eram processadas em 2 rodadas diárias,
#   gerando duplicatas por (fixture_id, market, side) WHERE forced=false.
#   Medido em prod: 303 grupos duplicados, 553 linhas extras, 127 verdict='bet'.
#
# Estratégia de limpeza:
#   Para cada grupo (fixture_id, market, side, forced=false) com > 1 linha:
#   - MANTER a linha referenciada por FK (closing_odds.ai_recommendation_id,
#     ai_reco_feedback.ai_recommendation_id, bets.ai_recommendation_id,
#     bet_slip_legs.ai_recommendation_id).
#   - Entre as não-referenciadas, MANTER a MAIS ANTIGA (menor id).
#   - DELETAR as restantes.
#
# Uso:
#   DATABASE_URL=... bundle exec bin/dedupe_ai_recommendations           # dry-run (default)
#   DATABASE_URL=... bundle exec bin/dedupe_ai_recommendations --execute # aplica
#
# IMPORTANTE: rodar --dry-run primeiro, validar a contagem e depois --execute.
# Depois: aplicar supabase/migrations/0052_ai_reco_dedup_index.sql.

require_relative '../lib/scraper/db'

dry_run = !ARGV.include?('--execute')

warn "[dedupe] modo: #{dry_run ? 'DRY-RUN (use --execute pra aplicar)' : 'EXECUTE'}"

# Identifica os IDs a DELETAR por grupo (fixture_id, market, side) não-forçado.
# Lógica:
#   1. Reúne todos os ids do grupo.
#   2. Remove o(s) referenciado(s) por FK ativa (closing_odds, feedback, bets, bet_slip_legs).
#   3. Do restante, mantém o mais antigo (MIN id) e deleta os demais.
FIND_DUPLICATES_SQL = <<~SQL
  WITH groups AS (
    SELECT
      fixture_id,
      market,
      side,
      array_agg(id ORDER BY id ASC) AS ids
    FROM ai_recommendations
    WHERE forced = false
      AND market IS NOT NULL
      AND side   IS NOT NULL
    GROUP BY fixture_id, market, side
    HAVING count(*) > 1
  ),
  referenced_ids AS (
    SELECT DISTINCT ai_recommendation_id AS id
    FROM (
      SELECT ai_recommendation_id FROM closing_odds         WHERE ai_recommendation_id IS NOT NULL
      UNION ALL
      SELECT ai_recommendation_id FROM ai_reco_feedback     WHERE ai_recommendation_id IS NOT NULL
      UNION ALL
      SELECT ai_recommendation_id FROM bets                 WHERE ai_recommendation_id IS NOT NULL
      UNION ALL
      SELECT ai_recommendation_id FROM bet_slip_legs        WHERE ai_recommendation_id IS NOT NULL
    ) fks
  )
  SELECT
    g.fixture_id,
    g.market,
    g.side,
    g.ids,
    (
      -- IDs do grupo que NÃO têm referência por FK
      SELECT array_agg(elem ORDER BY elem ASC)
      FROM unnest(g.ids) AS elem
      WHERE elem NOT IN (SELECT id FROM referenced_ids)
    ) AS unreferenced_ids
  FROM groups g
  ORDER BY g.fixture_id, g.market, g.side
SQL

AdamStats::Scraper::DB.with_connection do |conn|
  rows = conn.query(FIND_DUPLICATES_SQL).to_a

  if rows.empty?
    warn '[dedupe] nenhuma duplicata encontrada — banco já está limpo.'
    next
  end

  total_groups = rows.length

  # Cada grupo termina com EXATAMENTE 1 linha (senão o índice único da 0052
  # não cria). keep = a REFERENCIADA mais antiga, se houver (não podemos
  # deletá-la sem quebrar FK); senão a mais antiga do grupo. Todas as outras:
  # FKs re-apontadas pra keep e linha deletada — inclusive referenciadas
  # extras (closing_odds/feedback/bets/legs migram pra keep; o conteúdo das
  # duplicatas é a mesma reco emitida 2x, então o re-point é semanticamente
  # neutro).
  ids_to_delete = []
  repoints = [] # [delete_id, keep_id]

  rows.each do |row|
    group_ids = row['ids'].gsub(/[{}]/, '').split(',').map(&:to_i)
    unreferenced_raw = row['unreferenced_ids']
    unreferenced = if unreferenced_raw.nil? || unreferenced_raw == '{}'
                     []
                   else
                     unreferenced_raw.gsub(/[{}]/, '').split(',').map(&:to_i)
                   end
    referenced = group_ids - unreferenced

    keep_id = referenced.first || group_ids.first
    delete_ids = group_ids - [keep_id]

    delete_ids.each { |id| repoints << [id, keep_id] if referenced.include?(id) }
    ids_to_delete.concat(delete_ids)
  end

  warn "[dedupe] #{total_groups} grupos duplicados, #{ids_to_delete.length} linhas a deletar " \
       "(#{repoints.length} com FK a re-apontar)"

  if dry_run
    warn '[dedupe] DRY-RUN: nada alterado. Use --execute pra aplicar.'
    warn "[dedupe] IDs que seriam deletados (primeiros 20): #{ids_to_delete.first(20).inspect}"
    warn "[dedupe] Re-points (delete_id → keep_id): #{repoints.first(20).inspect}"
    next
  end

  if ids_to_delete.empty?
    warn '[dedupe] nada a deletar.'
    next
  end

  # Busca verdicts pra estatísticas pré-delete
  verdict_counts = Hash.new(0)
  verdict_rows = conn.exec_params(
    "SELECT verdict, count(*) AS n FROM ai_recommendations WHERE id = ANY($1) GROUP BY verdict",
    ["{#{ids_to_delete.join(',')}}"]
  ).to_a
  verdict_rows.each { |r| verdict_counts[r['verdict']] = r['n'].to_i }

  conn.query('BEGIN')
  begin
    repoints.each do |delete_id, keep_id|
      %w[closing_odds ai_reco_feedback bets bet_slip_legs].each do |table|
        conn.exec_params(
          "UPDATE #{table} SET ai_recommendation_id = $1 WHERE ai_recommendation_id = $2",
          [keep_id, delete_id]
        )
      end
    end

    deleted = conn.exec_params(
      "DELETE FROM ai_recommendations WHERE id = ANY($1) RETURNING id",
      ["{#{ids_to_delete.join(',')}}"]
    ).ntuples

    # Verificação dentro da transação: resíduo de duplicatas deve ser ZERO.
    residue = conn.query(<<~SQL).to_a
      SELECT count(*) AS n FROM (
        SELECT 1 FROM ai_recommendations
        WHERE forced = false AND market IS NOT NULL AND side IS NOT NULL
        GROUP BY fixture_id, market, side
        HAVING count(*) > 1
      ) t
    SQL
    raise "resíduo de #{residue.first['n']} grupos duplicados após a limpeza — ROLLBACK" if residue.first['n'].to_i.positive?

    conn.query('COMMIT')

    warn "[dedupe] #{deleted} linhas deletadas, #{repoints.length} FKs re-apontadas, resíduo 0"
    verdict_counts.each do |verdict, count|
      warn "[dedupe]   #{verdict}: #{count}"
    end
    warn '[dedupe] DONE. Agora aplique supabase/migrations/0052_ai_reco_dedup_index.sql'
  rescue StandardError => e
    conn.query('ROLLBACK')
    warn "[dedupe] FALHOU (rollback aplicado): #{e.class}: #{e.message}"
    raise
  end
end
