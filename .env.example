# Supabase — projeto Abissal
NEXT_PUBLIC_SUPABASE_URL=https://etdrxzgspgslunivhrbe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — usar com cuidado, nunca expor ao client
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Recommender
# - AI_RECO_MODEL: usado pelo cron Ruby (batch noturno). R1 reasoning é lento
#   (p95 ~195s) mas barato e de alta qualidade — aceitável fora do hot path.
# - AI_RECO_MODEL_ONDEMAND: usado por POST /api/ai-reco/compute (botão
#   "[ pedir análise IA ]" em /fixtures/[id]). 2026-05-25: revertido pra R1
#   por decisão de produto (consistência batch=on-demand). Latência ~40s p50.
AI_RECO_MODEL=deepseek/deepseek-r1
AI_RECO_MODEL_ONDEMAND=deepseek/deepseek-r1

# Wave P — Telegram closure bot (nightly 23h BRT summary via GitHub Actions)
# Obtain TELEGRAM_BOT_TOKEN via @BotFather on Telegram.
# TELEGRAM_CHAT_ID: your private chat ID (use @userinfobot to find it).
# Set both in GitHub Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID).
# The workflow also needs NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# (already defined above — add to Secrets if not already present).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
